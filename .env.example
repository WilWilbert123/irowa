# IroWa Environment Configuration
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map Tiles (OpenStreetMap - free, no key required)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ==============================================================================
# Firebase Cloud Messaging (FCM) Push Notifications Configuration
# ==============================================================================
# 1. Go to Firebase Console (https://console.firebase.google.com)
# 2. Project Settings -> General -> "Your apps" section -> Web App (</>)
# 3. Copy the values from firebaseConfig:
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Web Push Key Pair (VAPID key)
# In Firebase Console -> Project Settings -> Cloud Messaging -> "Web configuration" tab
# Under "Web Push certificates", click "Generate key pair" and paste it here:
NEXT_PUBLIC_FIREBASE_VAPID_KEY=B...your-firebase-web-push-key-pair

# Server-Side Firebase Admin (for sending push notifications from Next.js server actions/API)
# In Firebase Console -> Project Settings -> "Service accounts" tab -> "Generate new private key"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
